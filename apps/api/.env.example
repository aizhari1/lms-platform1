# =========================================================================
# LMS PLATFORM — BACKEND ENVIRONMENT VARIABLES (NestJS)
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file to version control.
# =========================================================================

# --------------------------- App ---------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --------------------------- Database (PostgreSQL) ---------------------------
DATABASE_URL="postgresql://lms_user:lms_password@localhost:5432/lms_db?schema=public"

# --------------------------- Redis (Cache + Queues) ---------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=lms_redis_password
REDIS_TTL_SECONDS=3600

# --------------------------- JWT / Auth ---------------------------
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------- Storage (AWS S3 / Cloudinary) ---------------------------
STORAGE_DRIVER=s3   # "s3" | "cloudinary" | "minio"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=lms-platform-media

# MinIO (local S3-compatible dev storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=lms_minio_admin
MINIO_SECRET_KEY=lms_minio_password
MINIO_BUCKET=lms-media

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------- Payments ---------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_ONLINE_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# --------------------------- Email (Resend) ---------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM_NAME="SIRAJ LMS"
MAIL_FROM_ADDRESS=no-reply@lms.example.com

# --------------------------- Notifications (Firebase Cloud Messaging) ---------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --------------------------- Search (Algolia) ---------------------------
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_COURSES_INDEX=courses

# --------------------------- Video Processing / CDN ---------------------------
CLOUDINARY_VIDEO_FOLDER=lms/videos
CDN_BASE_URL=https://cdn.lms.example.com

# --------------------------- Rate Limiting ---------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------- Realtime (Socket.IO) ---------------------------
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# --------------------------- Logging / Monitoring ---------------------------
LOG_LEVEL=debug
SENTRY_DSN=
