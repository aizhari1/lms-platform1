# =========================================================================
# LMS PLATFORM — FRONTEND ENVIRONMENT VARIABLES (Next.js 15)
# Copy this file to `.env.local` and fill in the real values.
# =========================================================================

NEXT_PUBLIC_APP_NAME="SIRAJ LMS"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (client-side publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Paymob iframe
NEXT_PUBLIC_PAYMOB_IFRAME_URL=https://accept.paymob.com/api/acceptance/iframes

# Algolia (public search-only key)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_COURSES_INDEX=courses

# Firebase (client SDK config for push notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=ar
